# Set to the final public HTTPS origin before deployment, for example https://example.com.
# Without this value, robots.txt blocks indexing and no URLs are emitted in sitemap.xml.
SITE_URL=

# Optional: paste the per-site script URL from Plausible's Site Installation settings.
# Analytics stays off until this is configured.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=

# Optional: a temporary password for the whole site. While set, every page shows the password screen
# until it is entered (phones keep the "desktop only" screen). Remove it to open the site.
SITE_PASSWORD=
